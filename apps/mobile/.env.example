# Salin ke apps/mobile/.env (lokal: scripts/dev-stack.sh menulis .env.local otomatis). Nilai publik saja — app native
# tidak memegang secret (sama dengan app Next, invarian 4). Build toko: isi lewat EAS (eas.json / eas env).
EXPO_PUBLIC_IDENTITY_URL=https://auth.example.com
EXPO_PUBLIC_IDENTITY_PUBLISHABLE_KEY=
EXPO_PUBLIC_CORE_URL=https://api.example.com
EXPO_PUBLIC_CORE_PUBLISHABLE_KEY=
# Storage project brand (cover & aset campaign)
EXPO_PUBLIC_BRAND_DB_URL=https://brand-db.example.com
EXPO_PUBLIC_BRAND_DB_PUBLISHABLE_KEY=
# Halaman web untuk langkah sekali jalan (KYC, rekening, hubungkan sosmed, onboarding) — dibuka di browser sistem.
EXPO_PUBLIC_APP_URL=https://app.example.com
EXPO_PUBLIC_ACCOUNTS_URL=https://accounts.example.com
EXPO_PUBLIC_BRAND_URL=https://brand.example.com
EXPO_PUBLIC_WEB_URL=https://example.com
# Opsional: sama dengan NEXT_PUBLIC_TURNSTILE_SITE_KEY (CAPTCHA login) bila Turnstile aktif di Auth identity.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
