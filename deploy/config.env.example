# Konfigurasi server (salin ke deploy/config.env tiap server — tidak masuk git). Secret: deploy/deploy.sh secrets.
# Format shell: nilai berspasi pakai tanda kutip. Tiga server: tiap server cukup mengisi bagian perannya
# (identity: SMTP, Google login, Resend, payout, Turnstile secret · core: OAuth sosmed · app: Turnstile site key, APP_IMAGE);
# DOMAIN/SCHEME sama semua.

# Domain utama. DNS A record ke IP server: DOMAIN, accounts., app., brand., admin., auth. (API identity), api. (API core).
DOMAIN=example.com
# Email untuk Let's Encrypt. SCHEME=http hanya untuk uji lokal tanpa sertifikat.
ACME_EMAIL=admin@example.com
SCHEME=https

# SMTP untuk email login OTP & undangan (GoTrue identity), mis. smtp.resend.com:465 user "resend" pass = API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@example.com
SMTP_SENDER_NAME=Clipper
# Batas email Auth per jam (OTP). Default 1000.
AUTH_EMAIL_RATE_LIMIT=1000

# Login "Masuk dengan Google" (Auth identity). OAuth client Google tipe Web, redirect URI https://auth.{DOMAIN}/auth/v1/callback.
# Kosong = login Google mati (tombolnya gagal); isi untuk mengaktifkan.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_SECRET=

# Email notifikasi platform (Edge Function identity, Resend API) — wajib di produksi; tanpa ini notifikasi email gagal.
RESEND_API_KEY=
EMAIL_FROM="Clipper <no-reply@example.com>"

# Payout instan: mock (tanpa transfer sungguhan) atau xendit. Webhook Xendit (Settings → Callbacks, Disbursement/Payout):
# https://auth.{DOMAIN}/functions/v1/disburse/callback; XENDIT_CALLBACK_TOKEN = "Callback Verification Token" di dashboard.
DISBURSE_PROVIDER=mock
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# OAuth platform sosmed (kosong = platform itu tidak bisa dihubungkan). Redirect URI: https://app.{DOMAIN}/api/oauth/<platform>/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Opsional (tiga server): alamat privat server lain untuk panggilan antar-server tanpa lewat internet, format
# "host=ip ...", mis. di server core: PEER_HOSTS="auth.example.com=10.0.0.11". Kosong = DNS publik (HTTPS tetap).
PEER_HOSTS=
# Opsional: IP host tempat Caddy listen (server ber-IP banyak). Kosong = semua interface.
CADDY_BIND=
# Opsional: IP publik server ini bila di belakang NAT (mis. VM cloud) — dipakai deploy.sh check untuk mencocokkan DNS.
PUBLIC_IP=
# Opsional (server app): image app yang sudah dibangun di CI (NEXT_PUBLIC_* ter-inline saat build → harus dibangun untuk
# DOMAIN & anon key yang sama). Kosong = dibangun di server ini.
APP_IMAGE=

# deploy.sh backup: simpan dump DB + file Storage sekian hari di deploy/stack/*/backups (salin ke luar server sendiri).
BACKUP_KEEP_DAYS=14

# Opsional: override compose tambahan untuk kedua stack Supabase (pisah ':'), relatif ke deploy/stack/<stack>/ atau
# path absolut — mis. docker-compose.s3.yml (storage S3, isi variabelnya di deploy/stack/<stack>/.env).
EXTRA_COMPOSE_FILES=

# Opsional (server identity): push app native (apps/mobile) dikirim lewat Expo Push API (exp.host). Isi access token
# hanya kalau "Enhanced push security" dinyalakan di akun Expo; kredensial FCM/APNs diunggah lewat EAS (eas credentials).
EXPO_ACCESS_TOKEN=

# Opsional (server identity): Live Activity iOS payout (push-to-start + update) dikirim langsung ke APNs. Apple Developer →
# Certificates, IDs & Profiles → Keys → "+" centang Apple Push Notifications service (APNs) → unduh AuthKey_<KEYID>.p8
# (hanya bisa sekali). APNS_KEY_ID = Key ID, APNS_TEAM_ID = Team ID (Membership details), APNS_BUNDLE_ID = bundle id app
# iOS (ios.bundleIdentifier), APNS_ENV=sandbox untuk build development (kosong = produksi). APNS_PRIVATE_KEY = isi .p8
# dalam tanda kutip ganda, boleh multi-baris apa adanya, atau satu baris dengan "\n" di antara baris; deploy.sh
# menyimpannya satu baris di deploy/stack/identity/.env (0600). Kosongkan semua = Live Activity mati, push biasa tetap jalan.
#   APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
#   MIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...
#   -----END PRIVATE KEY-----"
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_ENV=
APNS_PRIVATE_KEY=

# Opsional (server app): app Android di Play Store = app native apps/mobile (EAS) atau TWA dari PWA app.{DOMAIN}
#   (npx @bubblewrap/cli init --manifest https://app.{DOMAIN}/manifest.webmanifest && npx @bubblewrap/cli build).
# Isi package app-nya dan sidik jari SHA-256 sertifikat signing (Play Console → Setup → App signing; boleh beberapa,
# pisah koma). Kosong = app.{DOMAIN}/.well-known/assetlinks.json 404 (TWA tampil dengan address bar, link
# app.{DOMAIN} tidak langsung membuka app native).
ANDROID_APP_PACKAGE=
ANDROID_CERT_SHA256=
# Opsional (server app): universal link app iOS native = Team ID Apple (10 karakter) + bundle id. Kosong = pakai
# APNS_TEAM_ID / APNS_BUNDLE_ID; keduanya kosong = apple-app-site-association 404.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=

# Opsional: Cloudflare Turnstile di form login (accounts., app., admin.). Isi KEDUANYA atau kosongkan keduanya: site key
# di server app (widget), secret key di server identity (Auth memverifikasi token). Hostname widget di dashboard
# Cloudflare: accounts.{DOMAIN}, app.{DOMAIN}, admin.{DOMAIN}.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
