# Konfigurasi server (salin ke deploy/config.env — tidak masuk git). Secret dibuat otomatis ke deploy/secrets.env.
# Format shell: nilai berspasi pakai tanda kutip.

# Domain utama. DNS A record ke IP server: DOMAIN, accounts., app., brand., admin., auth. (API identity), api. (API core).
DOMAIN=example.com
# Email untuk Let's Encrypt. SCHEME=http hanya untuk uji lokal tanpa sertifikat.
ACME_EMAIL=admin@example.com
SCHEME=https

# SMTP untuk email login OTP & undangan (GoTrue identity), mis. smtp.resend.com:465 user "resend" pass = API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@example.com
SMTP_SENDER_NAME=Clipper
# Batas email Auth per jam (OTP). Default 1000.
AUTH_EMAIL_RATE_LIMIT=1000

# Email notifikasi platform (Edge Function identity, Resend API) — wajib di produksi; tanpa ini notifikasi email gagal.
RESEND_API_KEY=
EMAIL_FROM="Clipper <no-reply@example.com>"

# Payout instan: mock (tanpa transfer sungguhan) atau xendit.
DISBURSE_PROVIDER=mock
XENDIT_SECRET_KEY=

# OAuth platform sosmed (kosong = platform itu tidak bisa dihubungkan). Redirect URI: https://app.{DOMAIN}/api/oauth/<platform>/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Opsional: override compose tambahan untuk kedua stack Supabase (pisah ':'), relatif ke deploy/stack/<stack>/ atau
# path absolut — mis. docker-compose.s3.yml (storage S3, isi variabelnya di deploy/stack/<stack>/.env).
EXTRA_COMPOSE_FILES=

# Opsional: Cloudflare Turnstile di form login.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
