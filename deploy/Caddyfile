# Reverse proxy publik (HTTPS otomatis Let's Encrypt saat SCHEME=https). Di network docker "clipper", container ini juga
# punya alias semua host publik (apps.yml) supaya fetch server-side app ke auth./api. tidak keluar ke internet; Auth &
# Edge Function stack Supabase mencapainya lewat extra_hosts host-gateway (deploy/supabase/common.yml).
{
	email {$ACME_EMAIL}
}

{$SCHEME}://{$DOMAIN} {
	reverse_proxy web:3000
}
{$SCHEME}://accounts.{$DOMAIN} {
	reverse_proxy accounts:3001
}
{$SCHEME}://app.{$DOMAIN} {
	reverse_proxy clipper:3002
}
{$SCHEME}://brand.{$DOMAIN} {
	reverse_proxy brand:3003
}
{$SCHEME}://admin.{$DOMAIN} {
	reverse_proxy admin:3004
}

# API Supabase: hanya path yang dipakai platform; Studio, /pg (postgres-meta), dan /realtime tidak dibuka ke publik.
(supabase_api) {
	@api path /auth/v1/* /rest/v1/* /storage/v1/* /functions/v1/*
	handle @api {
		reverse_proxy {args[0]}
	}
	handle {
		respond 404
	}
}
{$SCHEME}://auth.{$DOMAIN} {
	# Template email GoTrue identity (GOTRUE_MAILER_TEMPLATES_*): HTML statis tanpa data user.
	handle /email/* {
		root * /srv
		file_server
	}
	import supabase_api identity-gw:8000
}
{$SCHEME}://api.{$DOMAIN} {
	import supabase_api core-gw:8000
}

