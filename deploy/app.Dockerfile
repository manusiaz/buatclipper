# Satu image untuk 5 app Next.js (deploy/apps.yml menjalankan `pnpm --filter ./apps/<app> start` per container).
# NEXT_PUBLIC_* di-inline saat build; nilainya publik (URL + publishable key), bukan secret.
FROM node:22.20.0-bookworm-slim
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY apps/accounts/package.json apps/accounts/
COPY apps/clipper/package.json apps/clipper/
COPY apps/brand/package.json apps/brand/
COPY apps/admin/package.json apps/admin/
COPY packages ./packages
RUN pnpm install --frozen-lockfile
COPY . .
ARG NEXT_PUBLIC_IDENTITY_URL NEXT_PUBLIC_IDENTITY_PUBLISHABLE_KEY NEXT_PUBLIC_CORE_URL NEXT_PUBLIC_CORE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_BRAND_DB_URL NEXT_PUBLIC_BRAND_DB_PUBLISHABLE_KEY NEXT_PUBLIC_CREATOR_DB_URL NEXT_PUBLIC_CREATOR_DB_PUBLISHABLE_KEY \
    NEXT_PUBLIC_COOKIE_DOMAIN NEXT_PUBLIC_WEB_URL NEXT_PUBLIC_ACCOUNTS_URL NEXT_PUBLIC_APP_URL NEXT_PUBLIC_BRAND_URL \
    NEXT_PUBLIC_ADMIN_URL NEXT_PUBLIC_VAPID_PUBLIC_KEY NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_IDENTITY_URL=$NEXT_PUBLIC_IDENTITY_URL NEXT_PUBLIC_IDENTITY_PUBLISHABLE_KEY=$NEXT_PUBLIC_IDENTITY_PUBLISHABLE_KEY \
    NEXT_PUBLIC_CORE_URL=$NEXT_PUBLIC_CORE_URL NEXT_PUBLIC_CORE_PUBLISHABLE_KEY=$NEXT_PUBLIC_CORE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_BRAND_DB_URL=$NEXT_PUBLIC_BRAND_DB_URL NEXT_PUBLIC_BRAND_DB_PUBLISHABLE_KEY=$NEXT_PUBLIC_BRAND_DB_PUBLISHABLE_KEY \
    NEXT_PUBLIC_CREATOR_DB_URL=$NEXT_PUBLIC_CREATOR_DB_URL NEXT_PUBLIC_CREATOR_DB_PUBLISHABLE_KEY=$NEXT_PUBLIC_CREATOR_DB_PUBLISHABLE_KEY \
    NEXT_PUBLIC_COOKIE_DOMAIN=$NEXT_PUBLIC_COOKIE_DOMAIN NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL \
    NEXT_PUBLIC_ACCOUNTS_URL=$NEXT_PUBLIC_ACCOUNTS_URL NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_BRAND_URL=$NEXT_PUBLIC_BRAND_URL NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL \
    NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY
RUN pnpm -r --filter "./apps/*" build
