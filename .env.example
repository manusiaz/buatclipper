# Env app Next.js (satu set per project Vercel; semua publik — secret TIDAK pernah ada di app, §15.7).
# Lokal: scripts/dev-stack.sh menyalakan kedua stack Supabase lalu menulis apps/*/.env.local.
NEXT_PUBLIC_IDENTITY_URL=https://auth.example.com
NEXT_PUBLIC_IDENTITY_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_CORE_URL=https://<core-ref>.supabase.co
NEXT_PUBLIC_CORE_PUBLISHABLE_KEY=sb_publishable_xxx
# DB brand (org, tim, undangan, agency, isi + storage campaign): semua app (cover campaign publik)
NEXT_PUBLIC_BRAND_DB_URL=https://<brand-ref>.supabase.co
NEXT_PUBLIC_BRAND_DB_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_COOKIE_DOMAIN=.example.com
NEXT_PUBLIC_WEB_URL=https://example.com
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_BRAND_URL=https://brand.example.com
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com
# Opsional
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
